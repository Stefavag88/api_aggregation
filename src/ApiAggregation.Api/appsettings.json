{
  "Discovery": {
    "ProviderCandidateLimit": 30
  },
  "Caching": {
    "SizeLimit": 1000,
    "FetchTimeout": "00:00:05",
    "Default": {
      "FreshDuration": "00:05:00",
      "MaximumAge": "00:30:00",
      "RetryInterval": "00:00:30"
    }
  },
  "Statistics": {
    "SnapshotInterval": "00:00:01",
    "AnomalyCheckInterval": "00:01:00"
  },
  "ProviderResilience": {
    "AttemptTimeout": "00:00:02",
    "RetryDelay": "00:00:00.200",
    "ConcurrencyLimit": 8,
    "CircuitFailureRatio": 0.5,
    "CircuitMinimumThroughput": 10,
    "CircuitSamplingDuration": "00:00:30",
    "CircuitBreakDuration": "00:00:15"
  },
  "Providers": {
    "GitHub": {
      "Enabled": true,
      "BaseAddress": "https://api.github.com/"
    },
    "DevTo": {
      "Enabled": true,
      "BaseAddress": "https://dev.to/"
    },
    "HackerNews": {
      "Enabled": true,
      "BaseAddress": "https://hn.algolia.com/"
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
